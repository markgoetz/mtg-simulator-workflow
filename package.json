{
  "name": "mtg-simulator-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "decklist": "tsx src/main.ts",
    "cards:refresh": "tsx scripts/refreshCards.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:deps": "depcruise src scripts --config .dependency-cruiser.cjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:deps && npm test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
